# Copy to .env.local (never committed) and fill in.

# Claude API key for Screening. Alternatively log in once with `ant auth login`.
ANTHROPIC_API_KEY=

# Hard monthly cap for Claude API spend in USD (docs/adr/0005). Default: 10.
DEALFLOW_MONTHLY_CAP_USD=10

# Where the local database lives. Default: .data/pglite
DEALFLOW_DB_DIR=.data/pglite

# The day you last read and accepted the SHAB terms (https://www.shab.ch/static/agb_de.pdf).
# The job refuses to run when this is missing or more than 90 days old (docs/adr/0002).
SHAB_TERMS_ACCEPTED_ON=

# Hosted Postgres (Neon, Frankfurt). Leave empty to use the local database in .data/.
DATABASE_URL=

# Sign-in with GitHub (Auth.js). Leave all four empty on your own machine: the radar then runs
# without login locally, and a deployment without them stays shut (docs/adr/0007).
# DEALFLOW_OWNER_GITHUB_ID is the Owner's numeric GitHub id: gh api user --jq .id
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
DEALFLOW_OWNER_GITHUB_ID=
